#include "../../Flutter/Flutter-Debug.xcconfig"
#include "Warnings.xcconfig"

// Disable code signing — for SKIP_FASTLANE=1 local unsigned builds.
// Same rationale as Release.xcconfig — without this, `flutter run`
// fails on missing provisioning profiles when Apple certs aren't set up.
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO
CODE_SIGN_IDENTITY =
