#!/bin/sh
# tun-routes — маршруты и DNS для TUN-режима backuppc-client.
#
#   tun-routes up    — после старта ядра (ExecStartPost)
#   tun-routes down  — после остановки (ExecStopPost); идемпотентно
#
# Xray поднимает только сам интерфейс (proxy/tun/README.md), остальное здесь.
# Схема — policy routing по образцу wg-quick:
#
#   pref 7740  uidrange <uid службы>  → main   ядро ходит к серверу напрямую
#   pref 7741  main suppress_prefixlength 0    LAN и прочие точные маршруты
#   pref 7742  → таблица 7742: default dev $TUN всё остальное — в туннель
#
# Петли нет без знания IP сервера: исключение — по uid процесса ядра.
#
# Серверный режим (SERVER_MODE=1, import -server-mode): соединения, пришедшие
# снаружи на интерфейс основного маршрута (uplink), помечаются conntrack-меткой
# (nftables, таблица inet backuppc_client); ответы на них — по fwmark мимо
# туннеля, иначе входящие подключения к сервисам хоста и опубликованным портам
# Docker обрываются. Исходящие соединения хоста и контейнеров — в туннель.
#
#   pref 7739  fwmark 0x7743 → main            ответы на входящие (серверный режим)
# DNS: resolvectl направляет все запросы через $TUN на $TUN_DNS; ядро
# отвечает на них своим DNS по TCP через туннель (tun.json).
set -eu

CONF_DIR="${BACKUPPC_CLIENT_DIR:-/etc/backuppc-client}"
SERVICE_USER="${BACKUPPC_CLIENT_USER:-backuppc-client}"
TABLE=7742
PREF_UID=7740
PREF_SUPPRESS=7741
PREF_TABLE=7742
PREF_MARK=7739
MARK=0x7743
NFT_TABLE=backuppc_client
# 198.18.0.0/15 (RFC 2544, бенчмарки) — Docker и DHCP его не выдают;
# 172.16/12 занят сетями Docker (br-*), 10/8 и 192.168/16 — LAN.
ADDR4=198.18.0.1/30
ADDR6=fdfe:dcba:9876::1/126

log() { echo "tun-routes: $*" >&2; }

# shellcheck source=/dev/null
. "$CONF_DIR/tun.env"
: "${TUN_NAME:?tun.env: нет TUN_NAME}"
: "${TUN_DNS:?tun.env: нет TUN_DNS}"

families() {
    echo 4
    # IPv6 может быть выключен ядром (ipv6.disable=1) — тогда только v4
    [ -e /proc/net/if_inet6 ] && echo 6
    return 0
}

rules_del() {
    for f in $(families); do
        for pref in $PREF_MARK $PREF_UID $PREF_SUPPRESS $PREF_TABLE; do
            while ip -"$f" rule del pref "$pref" 2>/dev/null; do :; done
        done
        ip -"$f" route flush table "$TABLE" 2>/dev/null || true
    done
}

# uplinks — интерфейсы маршрутов по умолчанию (кроме самого TUN).
uplinks() {
    for f in $(families); do
        ip -"$f" route show default table main 2>/dev/null |
            awk '{for (i = 1; i < NF; i++) if ($i == "dev") print $(i + 1)}'
    done | grep -vx "$TUN_NAME" | sort -u
}

server_mode_up() {
    if ! command -v nft >/dev/null 2>&1; then
        log "серверный режим: нужен nftables (apt install nftables)"
        exit 1
    fi
    devs=$(uplinks)
    if [ -z "$devs" ]; then
        log "серверный режим: нет маршрута по умолчанию — не на чем различать входящие"
        exit 1
    fi
    # shellcheck disable=SC2086 # devs — список через перевод строки
    devset=$(printf '"%s", ' $devs)
    # ct mark — на всё соединение, meta mark — на каждый ответный пакет:
    # prerouting (ответы контейнеров через опубликованные порты), output
    # (ответы сервисов самого хоста; type route — перемаршрутизация по метке).
    nft -f - <<NFT
table inet $NFT_TABLE {
    chain prerouting {
        type filter hook prerouting priority mangle; policy accept;
        iifname { ${devset%, } } ct state new ct mark set $MARK
        ct mark $MARK meta mark set ct mark
    }
    chain output {
        type route hook output priority mangle; policy accept;
        ct mark $MARK meta mark set ct mark
    }
}
NFT
    # строгий rp_filter проверял бы входящие по таблице туннеля; с
    # src_valid_mark он учитывает метку (так же делает wg-quick)
    sysctl -q -w net.ipv4.conf.all.src_valid_mark=1 2>/dev/null ||
        log "src_valid_mark не установлен: при строгом rp_filter=1 входящие могут отбрасываться"
    for f in $(families); do
        ip -"$f" rule add pref "$PREF_MARK" fwmark "$MARK" lookup main
    done
    log "серверный режим: входящие через $(echo "$devs" | tr '\n' ' ')— мимо туннеля"
}

server_mode_down() {
    command -v nft >/dev/null 2>&1 && nft delete table inet "$NFT_TABLE" 2>/dev/null || true
}

dns_up() {
    # BACKUPPC_CLIENT_DNS=0 — не трогать DNS системы (тестовые стенды)
    [ "${BACKUPPC_CLIENT_DNS:-1}" = 0 ] && return 0
    if ! command -v resolvectl >/dev/null 2>&1; then
        log "resolvectl не найден: DNS системы НЕ направлен в туннель"
        return 0
    fi
    # shellcheck disable=SC2086 # TUN_DNS — список через пробел
    resolvectl dns "$TUN_NAME" $TUN_DNS
    resolvectl domain "$TUN_NAME" '~.'
    resolvectl default-route "$TUN_NAME" true
    resolvectl flush-caches 2>/dev/null || true
}

up() {
    uid=$(id -u "$SERVICE_USER") || { log "нет пользователя $SERVICE_USER"; exit 1; }

    i=0
    while ! ip link show dev "$TUN_NAME" >/dev/null 2>&1; do
        i=$((i + 1))
        [ "$i" -gt 50 ] && { log "интерфейс $TUN_NAME не появился за 10 с"; exit 1; }
        sleep 0.2
    done

    # адрес не должен пересекаться с чужим интерфейсом (иначе сломаем его сеть)
    busy=$(ip -o -4 addr show to "$ADDR4" | awk -v t="$TUN_NAME" '$2 != t {print $2}')
    if [ -n "$busy" ]; then
        log "адрес $ADDR4 уже занят интерфейсом $busy — TUN не настроен"
        exit 1
    fi

    rules_del
    server_mode_down
    ip addr replace "$ADDR4" dev "$TUN_NAME"
    ip link set dev "$TUN_NAME" up
    for f in $(families); do
        if [ "$f" = 6 ]; then
            ip -6 addr replace "$ADDR6" dev "$TUN_NAME" 2>/dev/null ||
                { log "IPv6 на $TUN_NAME недоступен — только IPv4"; continue; }
        fi
        ip -"$f" route replace default dev "$TUN_NAME" table "$TABLE"
        ip -"$f" rule add pref "$PREF_UID" uidrange "$uid-$uid" lookup main
        ip -"$f" rule add pref "$PREF_SUPPRESS" lookup main suppress_prefixlength 0
        ip -"$f" rule add pref "$PREF_TABLE" lookup "$TABLE"
    done
    [ "${SERVER_MODE:-0}" = 1 ] && server_mode_up
    dns_up
    log "$TUN_NAME: весь трафик через туннель, DNS → $TUN_DNS"
}

down() {
    rules_del
    server_mode_down
    if command -v resolvectl >/dev/null 2>&1 && ip link show dev "$TUN_NAME" >/dev/null 2>&1; then
        resolvectl revert "$TUN_NAME" 2>/dev/null || true
    fi
    command -v resolvectl >/dev/null 2>&1 && resolvectl flush-caches 2>/dev/null || true
    log "маршруты $TUN_NAME сняты"
}

case "${1:-}" in
up) up ;;
down) down ;;
*)
    echo "usage: $0 up|down" >&2
    exit 64
    ;;
esac
